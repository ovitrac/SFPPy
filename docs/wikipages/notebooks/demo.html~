<div class="cm-editor cm-s-jupyter">
<div class="highlight hl-ipython3"><pre><span></span><span class="c1"># 1:storage in stacks &gt;&gt; 2:hot-filled container &gt;&gt; 3:long-term storage of packaged food</span>
<span class="k">class</span> <span class="nc">contact1</span><span class="p">(</span><span class="n">stacked</span><span class="p">,</span> <span class="n">ambient</span><span class="p">):</span> <span class="n">name</span> <span class="o">=</span> <span class="s2">"1:setoff"</span><span class="p">;</span> <span class="n">contacttime</span> <span class="o">=</span> <span class="p">(</span><span class="mi">4</span><span class="p">,</span> <span class="s2">"months"</span><span class="p">)</span>
<span class="k">class</span> <span class="nc">contact2</span><span class="p">(</span><span class="n">hotfilled</span><span class="p">,</span> <span class="n">realfood</span><span class="p">,</span> <span class="n">liquid</span><span class="p">,</span> <span class="n">fat</span><span class="p">):</span> <span class="n">name</span> <span class="o">=</span> <span class="s2">"2:hotfilling"</span>
<span class="k">class</span> <span class="nc">contact3</span><span class="p">(</span><span class="n">ambient</span><span class="p">,</span> <span class="n">realfood</span><span class="p">,</span> <span class="n">liquid</span><span class="p">,</span> <span class="n">fat</span><span class="p">):</span> <span class="n">name</span> <span class="o">=</span> <span class="s2">"3:storage"</span><span class="p">;</span> <span class="n">contacttime</span> <span class="o">=</span> <span class="p">(</span><span class="mi">6</span><span class="p">,</span> <span class="s2">"months"</span><span class="p">)</span>
<span class="n">medium1</span><span class="p">,</span> <span class="n">medium2</span><span class="p">,</span> <span class="n">medium3</span> <span class="o">=</span> <span class="n">contact1</span><span class="p">(),</span> <span class="n">contact2</span><span class="p">(),</span> <span class="n">contact3</span><span class="p">()</span>
<span class="n">display</span><span class="p">(</span><span class="n">separator2</span><span class="p">)</span>
</pre></div>
