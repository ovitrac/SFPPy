      "with_food_contact": false,
      "setoff_type": "stacked"
    },
    {
      "index": 2,
      "name": "Hot filling",
      "type": "hotfilling",
      "temperature": {"value": 80, "unit": "degC"},
      "duration": {"value": 20, "unit": "minutes"},
