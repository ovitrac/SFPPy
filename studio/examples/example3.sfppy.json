{
  "version": "1.1",
  "metadata": {
    "name": "Example 3: Trilayer ABA Migration with Multi-Step",
    "description": "Migration of limonene from recycled PP core through PET barrier layers. Trilayer ABA structure (wPET/PP/gPET) with three contact steps: setoff (stacked storage), hotfilling, storage. Demonstrates proper multi-step temperature handling and set-off boundary conditions.",
    "author": "INRAE/olivier.vitrac@agroparistech.fr",
    "source_script": "example3.py",
    "sfppy_version": "1.50+"
  },
  "geometry": {
    "shape": "box_container",
    "dimensions": {
      "length": {"value": 19, "unit": "cm"},
      "width": {"value": 10, "unit": "cm"},
      "height": {"value": 8, "unit": "cm"}
    }
  },
