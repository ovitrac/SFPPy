          "k_auto": true
        }
      ]
    },
    {
      "index": 3,
      "polymer": "gPET",
      "thickness": {"value": 20, "unit": "um"},
      "name": "PET barrier (outer)",
      "substances": [
        {
          "substance_id": "limonene",
          "C0": {"value": 0, "unit": "mg/kg"},
          "D_auto": true,
          "k_auto": true
        }
