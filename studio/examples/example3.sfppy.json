    }
  ],
  "simulation_config": {
    "solver": "senspatankar",
    "ntimes": 1000,
    "nmesh": 600,
    "nmeshmin": 20,
    "timescale": "sqrt",
    "RelTol": 1e-6,
    "AbsTol": 1e-6,
    "nmax": 15,
